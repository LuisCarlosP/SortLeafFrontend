{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "ONNXRUNTIME_NODE_INSTALL_CUDA=skip npm ci",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "docs",
  "routes": [
    {
      "src": "/api/((?:predict|chat|barcode|location)(?:/.*)?)$",
      "dest": "${BACKEND_URL}/$1",
      "env": ["BACKEND_URL"],
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "x-api-key" },
          "args": "$API_KEY",
          "env": ["API_KEY"]
        }
      ]
    },
    {
      "src": "/api/((?:auth|activity)(?:/.*)?|health)$",
      "dest": "${BACKEND_URL}/$1",
      "env": ["BACKEND_URL"]
    },
    { "src": "/api(?:/.*)?$", "status": 404 },
    { "handle": "filesystem" },
    { "src": "/[^.]*$", "methods": ["GET", "HEAD"], "dest": "/index.html" }
  ]
}
